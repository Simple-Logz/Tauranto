{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "functions": { "api/**/*.ts": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/$1" }],
  "crons": [{ "path": "/api/jobs/run", "schedule": "*/5 * * * *" }]
}
