EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_WAKE_PHRASE=hey tauranto
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_RESTAURANT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated secrets, deliberately separate from SUPABASE_SERVICE_ROLE_KEY so a
# leak of one does not also compromise the others. Generate each with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
OPENAI_API_KEY=
OPENAI_ACTION_MODEL=gpt-5.6
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
RESEND_API_KEY=
NOTIFICATION_FROM=Tauranto <approvals@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
APP_URL=http://localhost:8081
CRON_SECRET=
CONNECTOR_WEBHOOK_SECRET=
# Stripe billing. STRIPE_SECRET_KEY is your restricted/secret API key from
# the Stripe Dashboard. STRIPE_WEBHOOK_SECRET is the signing secret for the
# webhook endpoint you create pointing at <APP_URL>/api/billing/webhook,
# subscribed to checkout.session.completed, customer.subscription.updated,
# and customer.subscription.deleted. Basic/Enterprise checkout (POST
# /api/billing/checkout) throws a clear configuration error if these are
# unset — there is no free/paid bypass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Leave blank to run without error monitoring (nothing breaks).
# Set to a project DSN from sentry.io to have unexpected server errors
# reported there instead of only sitting in Vercel's function logs.
SENTRY_DSN=
